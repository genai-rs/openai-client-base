{
  "openapi": "3.1.0",
  "paths": {
    "/widgets": {
      "get": {
        "operationId": "listWidgets",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createWidget",
        "responses": {
          "201": {
            "description": "created"
          }
        }
      }
    },
    "/widgets/{id}": {
      "get": {
        "operationId": "getWidget",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Widget": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "pending"
            ]
          },
          "metadata": {
            "type": "object",
            "properties": {
              "tag": {
                "type": "string"
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      },
      "Legacy": {
        "type": "string"
      },
      "NewModel": {
        "type": "string"
      }
    }
  }
}
