          "id",
          "metadata"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ]
          },
          "metadata": {
            "type": "object",
            "properties": {
              "tag": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
